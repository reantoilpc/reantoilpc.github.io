---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPostSlug } from '../utils';
import { SITE_TITLE, TAGLINE, SITE_DESCRIPTION, GITHUB_URL } from '../consts';
const recent = (await getCollection('blog', ({ data }) => data.lang === 'zh-TW' && !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 5);
---
<BaseLayout title={`${SITE_TITLE} — ${TAGLINE['zh-TW']}`} description={SITE_DESCRIPTION['zh-TW']}>
  <section class="flex items-center gap-5 pt-4">
    <img src="https://github.com/reantoilpc.png" alt="Ray Hsu" width="72" height="72" class="avatar" />
    <div>
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{SITE_TITLE}</h1>
      <p class="meta mt-1.5" style="font-size:.82rem;color:var(--accent)">{TAGLINE['zh-TW']}</p>
    </div>
  </section>
  <p class="mt-5 leading-relaxed" style="color:var(--muted)">嗨，我是 Ray，一名 C# 後端工程師。這裡記錄我在 .NET、後端開發與工具上的文章與筆記。</p>
  <div class="mt-4 flex flex-wrap gap-2">
    <a href={GITHUB_URL} class="pill">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.9 11c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.4-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"></path></svg>
      GitHub
    </a>
    <a href="/rss.xml" class="pill">RSS</a>
  </div>

  <section class="mt-12">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="section-title">最新文章</h2>
      <a href="/blog" class="link-accent text-sm">全部 →</a>
    </div>
    <div class="space-y-3">
      {recent.map((p) => <PostCard href={`/blog/${getPostSlug(p)}`} title={p.data.title} pubDate={p.data.pubDate} tags={p.data.tags} description={p.data.description} />)}
    </div>
  </section>
</BaseLayout>
