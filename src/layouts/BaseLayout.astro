---
import '@fontsource-variable/space-grotesk';
import '@fontsource/noto-sans-tc/chinese-traditional-400.css';
import '@fontsource/noto-sans-tc/latin-400.css';
import '@fontsource/noto-sans-tc/chinese-traditional-700.css';
import '@fontsource/noto-sans-tc/latin-700.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';
interface Props { title: string; description: string; image?: string; wide?: boolean; widest?: boolean; }
const { title, description, image, wide = false, widest = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const maxW = widest ? 'max-w-7xl' : wide ? 'max-w-5xl' : 'max-w-3xl';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      const s = localStorage.getItem('theme');
      if (s === 'dark' || (!s && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark');
    </script>
    <BaseHead title={title} description={description} image={image} />
  </head>
  <body>
    <Header />
    <main class={`mx-auto ${maxW} px-4 py-8`}><slot /></main>
    <Footer />
  </body>
</html>
