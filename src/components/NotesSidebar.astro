---
import { getCollection } from 'astro:content';
const notes = await getCollection('notes', ({ data }) => data.lang === 'zh-TW');
const byCat = new Map();
for (const n of notes) {
  if (!byCat.has(n.data.category)) byCat.set(n.data.category, []);
  byCat.get(n.data.category).push(n);
}
// 分類內排序:order 升冪,同分時 updated 由新到舊(修正先前「分類內無排序」的痛點)
for (const items of byCat.values()) {
  items.sort(
    (a, b) =>
      a.data.order - b.data.order ||
      (b.data.updated?.valueOf() ?? 0) - (a.data.updated?.valueOf() ?? 0)
  );
}
// 分類間排序:各分類最小 order
const cats = [...byCat.entries()].sort(
  (a, b) =>
    Math.min(...a[1].map((n) => n.data.order)) - Math.min(...b[1].map((n) => n.data.order))
);
const current = Astro.url.pathname;
---
<details id="notesNav" class="notes-nav self-start text-sm md:sticky md:top-20">
  <summary class="notes-nav-toggle">
    <span>瀏覽分類</span>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </summary>
  <nav class="notes-nav-body" aria-label="筆記分類">
    {cats.map(([cat, items]) => (
      <div class="mb-4">
        <p class="mb-1 flex items-center justify-between font-semibold">
          <span>{cat}</span>
          <span class="meta">{items.length}</span>
        </p>
        <ul class="space-y-1">
          {items.map((n) => (
            <li>
              <a
                href={`/notes/${n.id}`}
                aria-current={current === `/notes/${n.id}` ? 'page' : undefined}
                class={`block transition-colors hover:text-[var(--accent)] ${current === `/notes/${n.id}` ? 'font-medium text-[var(--accent)]' : ''}`}
                style={current === `/notes/${n.id}` ? '' : 'color:var(--muted)'}
              >{n.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </nav>
</details>

<style>
  .notes-nav-toggle {
    display: flex;
    cursor: pointer;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    font-weight: 600;
    list-style: none;
  }
  .notes-nav-toggle::-webkit-details-marker { display: none; }
  .notes-nav[open] .notes-nav-toggle svg { transform: rotate(180deg); }
  .notes-nav-toggle svg { transition: transform 0.18s ease; flex: none; }
  .notes-nav-body { margin-top: 0.9rem; }
  @media (min-width: 768px) {
    .notes-nav > .notes-nav-toggle { display: none; }
    .notes-nav > .notes-nav-body { display: block; margin-top: 0; }
  }
</style>

<script is:inline>
  // 桌機預設展開(切換鈕由 CSS 隱藏);手機收合,點「瀏覽分類」才展開
  (function () {
    var d = document.getElementById('notesNav');
    if (d && matchMedia('(min-width: 768px)').matches) d.open = true;
  })();
</script>
